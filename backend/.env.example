# Copy to .env and adjust as needed. All have sensible defaults.
PORT=4000
PREDICT_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=labsentinel
TICK_SECONDS=3

# Optional: enables the LLM-powered Autonomous Agent. Without it, the agent
# falls back to a deterministic rule-based explanation and the app still runs.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Email alerts (health < 80% notification) ---
# Leave SMTP_USER / SMTP_PASS empty to disable email (alerts are logged only).
# Gmail: turn on 2-Step Verification, then create an App Password and paste it
# into SMTP_PASS (16 chars, no spaces). SMTP_USER is the sending Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Comma-separated recipients. Defaults to SMTP_USER if left blank.
ALERT_TO=
# Health percentage that triggers an alert, and the recovery level that re-arms it.
HEALTH_ALERT_THRESHOLD=70
HEALTH_ALERT_CLEAR=72

# --- LabX parts procurement (agent one-click purchase order) ---
# Leave blank to draft simulated orders (recommended for the demo). Set both to
# route the same order flow to a real LabX endpoint if one becomes available.
LABX_API_URL=
LABX_API_KEY=

# --- Optional: LLM-written report narrative via Groq ---
# Leave blank to use the built-in rule-based report text (no tokens, no cost).
# Set a Groq key to have the report narrative written by an LLM on your Groq account.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
